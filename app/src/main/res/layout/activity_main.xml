<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_fondo"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingLeft="16dp"
    android:paddingTop="18dp"
    android:paddingRight="16dp"
    android:paddingBottom="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Solicitudes de soporte"
            android:textColor="@color/color_texto"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Registro y seguimiento de atenciones"
            android:textColor="@color/color_texto_suave"
            android:textSize="15sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnTabNuevo"
                    style="@style/BotonTab"
                    android:text="Nuevo" />

                <Button
                    android:id="@+id/btnTabListar"
                    style="@style/BotonTab"
                    android:text="Listar" />

                <Button
                    android:id="@+id/btnTabEditar"
                    style="@style/BotonTab"
                    android:text="Editar" />

                <Button
                    android:id="@+id/btnTabBorrar"
                    style="@style/BotonTab"
                    android:text="Borrar" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/tabNuevo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_panel"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nueva solicitud"
                android:textColor="@color/color_texto"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                style="@style/EtiquetaCampo"
                android:text="Solicitante (requerido)" />

            <EditText
                android:id="@+id/etSolicitante"
                style="@style/CampoFormulario"
                android:hint="Nombre del solicitante"
                android:inputType="textPersonName" />

            <TextView
                style="@style/EtiquetaCampo"
                android:text="Problema (requerido)" />

            <EditText
                android:id="@+id/etProblema"
                style="@style/CampoFormulario"
                android:layout_height="86dp"
                android:gravity="top"
                android:hint="Descripcion del problema"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="3"
                android:paddingTop="12dp" />

            <TextView
                style="@style/EtiquetaCampo"
                android:text="Prioridad (requerido)" />

            <EditText
                android:id="@+id/etPrioridad"
                style="@style/CampoFormulario"
                android:hint="Prioridad: Baja, Media o Alta"
                android:inputType="textCapWords" />

            <TextView
                style="@style/EtiquetaCampo"
                android:text="Estado (requerido)" />

            <EditText
                android:id="@+id/etEstado"
                style="@style/CampoFormulario"
                android:hint="Estado: Pendiente, En proceso o Cerrado"
                android:inputType="textCapSentences" />

            <Button
                android:id="@+id/btnGuardar"
                style="@style/BotonFormulario"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_boton_primario"
                android:text="Guardar solicitud"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabListar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_panel"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Solicitudes registradas"
                android:textColor="@color/color_texto"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnListar"
                style="@style/BotonFormulario"
                android:background="@drawable/bg_boton_secundario"
                android:text="Actualizar lista"
                android:textColor="@color/color_primario_oscuro" />

            <TextView
                android:id="@+id/tvResultado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Sin registros"
                android:textColor="@color/color_texto_suave"
                android:textIsSelectable="true"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabEditar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_panel"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Actualizar solicitud"
                android:textColor="@color/color_texto"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                style="@style/EtiquetaCampo"
                android:text="ID (requerido)" />

            <EditText
                android:id="@+id/etIdActualizar"
                style="@style/CampoFormulario"
                android:hint="ID de la solicitud"
                android:inputType="number" />

            <TextView
                style="@style/EtiquetaCampo"
                android:text="Solicitante (requerido)" />

            <EditText
                android:id="@+id/etSolicitanteActualizar"
                style="@style/CampoFormulario"
                android:hint="Nuevo nombre del solicitante"
                android:inputType="textPersonName" />

            <TextView
                style="@style/EtiquetaCampo"
                android:text="Problema (requerido)" />

            <EditText
                android:id="@+id/etProblemaActualizar"
                style="@style/CampoFormulario"
                android:layout_height="86dp"
                android:gravity="top"
                android:hint="Nueva descripcion del problema"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="3"
                android:paddingTop="12dp" />

            <TextView
                style="@style/EtiquetaCampo"
                android:text="Prioridad (requerido)" />

            <EditText
                android:id="@+id/etPrioridadActualizar"
                style="@style/CampoFormulario"
                android:hint="Nueva prioridad"
                android:inputType="textCapWords" />

            <TextView
                style="@style/EtiquetaCampo"
                android:text="Estado (requerido)" />

            <EditText
                android:id="@+id/etEstadoActualizar"
                style="@style/CampoFormulario"
                android:hint="Nuevo estado"
                android:inputType="textCapSentences" />

            <Button
                android:id="@+id/btnActualizar"
                style="@style/BotonFormulario"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_boton_primario"
                android:text="Actualizar solicitud"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabBorrar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_panel"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Eliminar solicitud"
                android:textColor="@color/color_texto"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Ingresa el ID del registro que deseas eliminar."
                android:textColor="@color/color_texto_suave"
                android:textSize="15sp" />

            <TextView
                style="@style/EtiquetaCampo"
                android:text="ID (requerido)" />

            <EditText
                android:id="@+id/etIdEliminar"
                style="@style/CampoFormulario"
                android:hint="ID de la solicitud"
                android:inputType="number" />

            <Button
                android:id="@+id/btnEliminar"
                style="@style/BotonFormulario"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_boton_peligro"
                android:text="Eliminar solicitud"
                android:textColor="@android:color/white" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
